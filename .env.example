# ============================================================
# SISTEM PENGGUNAAN KENDERAAN CSB — Contoh Konfigurasi
# Salin fail ini sebagai `.env` dan isi nilai sebenar.
# `.env` dikecualikan dari git — JANGAN commit kredensial sebenar.
# ============================================================

# ===== DATABASE (PostgreSQL) =====
# WAJIB untuk fungsi database. Tanpa ini, server berjalan dalam mod
# DEGRADED (halaman web OK, tapi semua API database pulang 500).
# Semak status: GET /health  →  {"status":"ok","db":true}

# --- Railway (production) ---
# Guna reference supaya sentiasa mengikut plugin Postgres projek yang sama:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# (Taip `${{Post` dalam dashboard Railway dan pilih dari senarai cadangan)

# --- Lokal (development) ---
# Format: postgresql://pengguna:kata_laluan@host:port/nama_database
DATABASE_URL=postgresql://user:password@localhost:5432/kenderaan_db

# Nota: Tables dicipta automatik semasa server mula, dan admin lalai
# `admin`/`admin123` di-seed jika jadual admins kosong.

# ===== KONFIGURASI NOTIFIKASI =====

# --- EMAIL (Gmail SMTP) ---
# Untuk Gmail, anda perlu:
# 1. Aktifkan 2-Factor Authentication
# 2. Guna App Password (bukan kata laluan akaun)
# https://support.google.com/accounts/answer/185833
# Jika tiada konfigurasi ini, notifikasi email dilumpuhkan.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- SMS ---
# SMS telah DIBUANG (2026-09-18) — sistem menggunakan notifikasi emel sahaja (Brevo/SMTP).


# ===== CLOUDFLARE TUNNEL (pilihan) =====
# Digunakan oleh start-all.bat / start-tunnel.bat untuk expose portal ke internet.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ===== NOTA =====
# - Server memuatkan .env melalui .freebuff/preview-launch.js (persekitaran preview)
#   atau terus dari environment (Railway).
# - Kunci yang tidak dikenali akan DIABAIKAN secara senyap oleh kod —
#   pastikan nama kunci tepat seperti di atas.

# Rahsia HMAC untuk token sesi admin/pengguna (wajib TETAP di production supaya sesi kekal merentas deploy)
# Jana: python -c "import secrets; print(secrets.token_hex(48))"
ADMIN_SESSION_SECRET=

# Brevo API HTTP — emel production Railway (port SMTP disekat; API melalui port 443)
# Daftar: https://app.brevo.com -> SMTP & API -> API Keys (percuma 300 emel/hari)
# Bila diset, sistem hantar emel melalui Brevo API; bila kosong -> fallback SMTP Gmail (lokal)
BREVO_API_KEY=
