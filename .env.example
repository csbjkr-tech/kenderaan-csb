# ===== KONFIGURASI NOTIFIKASI =====
# Salin fail ini sebagai .env dan isi nilai sebenar

# ===== EMAIL (Gmail SMTP) =====
# Untuk Gmail, anda perlu:
# 1. Aktifkan 2-Factor Authentication
# 2. Guna App Password (bukan kata laluan akaun)
# https://support.google.com/accounts/answer/185833

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ===== SMS (Twilio) =====
# Dapatkan kelayakan di https://www.twilio.com/console

TWILIO_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+1234567890

# ===== NOTA =====
# - Jika tiada konfigurasi email, notifikasi email akan dilumpuhkan
# - Jika tiada konfigurasi SMS, notifikasi SMS akan dilumpuhkan
# - Sistem akan berfungsi tanpa notifikasi (hanya simpan dalam database)
